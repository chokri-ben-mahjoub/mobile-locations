rules_version = '2';

// Un seul compte Firebase partagé (pas d'inscription, pas de multi-
// tenant) : tous les documents sont à la racine (contracts, payments,
// attachments, utilityBills, settings/app), pas sous /users/{uid}/...
// — toute règle qui exigerait ce chemin bloquerait l'app entière.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
